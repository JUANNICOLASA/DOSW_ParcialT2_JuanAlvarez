ado al grupo de recursos.&lt;br&gt;• Pipeline: test → docker → deploy en cada push a develop y main." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#1A1A1A;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1600" y="90" width="330" height="300" as="geometry"/></mxCell><mxCell id="v30" value="Leyenda" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#1A1A1A;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1600" y="430" width="330" height="276" as="geometry"/></mxCell><mxCell id="v31" value="" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#1A1A1A;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1612" y="462" width="50" height="22" as="geometry"/></mxCell><mxCell id="v32" value="Dispositivo externo" style="text;html=1;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1672" y="460" width="250" height="26" as="geometry"/></mxCell><mxCell id="v33" value="" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1A1A1A;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1612" y="492" width="50" height="22" as="geometry"/></mxCell><mxCell id="v34" value="Servicio de CI/CD (GitHub, Docker Hub)" style="text;html=1;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1672" y="490" width="250" height="26" as="geometry"/></mxCell><mxCell id="v35" value="" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutl